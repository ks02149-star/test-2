# Python Cache
__pycache__/
*.py[cod]
*$py.class

# PyInstaller / Build outputs
build/
dist/
*.spec
*.exe

# User Settings and Local Data
# Do not track local user accounts, holidays, and settings
Data/
Workspace/

# Log Files
*.log
error_log.txt

# Editor / IDE
.vscode/
.idea/
*.swp
*.bak

# Virtual Environment
venv/
.env

# Excel Output Files & Temp Files
# If you want to track a template Excel, keep it in an assets folder.
# This ignores active working Excel files that change frequently.
~$*.xlsx
키워드_순위_작업표*.xlsx

# Temporary migration scripts
test_runner.py
patch_*.py